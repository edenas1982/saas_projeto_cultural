# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# You can find these in your Supabase project settings -> API
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (Text Generation)
# AI_PROVIDER can be 'claude' or 'gemini'
AI_PROVIDER=gemini

# Se usar Gemini:
GEMINI_API_KEY=sua-chave-api-gemini

# Se usar Anthropic (Claude):
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Cloud TTS (Audio generation)
# Você pode usar a API Key OU o JSON da conta de serviço. 
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Configurações de Email (Google Workspace / Gmail - Nodemailer)
# Para usar contas do Google, você precisará gerar uma "App Password" (Senha de App)
# na sua Conta do Google > Segurança > Verificação em duas etapas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@ecomemoriasapp.com
SMTP_PASS=sua-senha-de-app-aqui