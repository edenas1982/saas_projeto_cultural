        }
        lines {
          text: "Gere a biografia em quatro blocos claramente separados usando exatamente estes marcadores. IDENTIDADE_INICIO e IDENTIDADE_FIM para o bloco da gaveta Identidade. JORNADA_INICIO e JORNADA_FIM para o bloco da gaveta Jornada. ESSENCIA_INICIO e ESSENCIA_FIM para o bloco da gaveta Essencia. LEGADO_INICIO e LEGADO_FIM para o bloco da gaveta Legado.`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
