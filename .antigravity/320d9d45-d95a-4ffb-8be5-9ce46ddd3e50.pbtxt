    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { createClient } from \"@supabase/supabase-js\";\nimport dotenv from \"dotenv\";\ndotenv.config();\n\nlet supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.VITE_SUPABASE_URL;\nconst supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\nsupabaseUrl = supabaseUrl?.replace(/\\/rest\\/v1\\/?$/, \'\').replace(/\\/$/, \'\');\n\nconst supabase = createClient(supabaseUrl!, supabaseKey!);\n\nasync function run() {\n  const targetUserId = \"78654881-7776-4391-8e3f-03d54bc135d9\"; // nascimentopalotina@gmail.com\n  const sourceUserId = \"466c123c-d367-47cb-aba6-007d24eb609f\"; // contato@ecomemoriasapp.com\n\n  console.log(`Transferring \"Maximiliano Mamado\" and any other memorials owned by ${sourceUserId} to ${targetUserId}...`);\n\n  // 1. Update Maximiliano Mamado structure\n  const { data: updated, error } = await supabase\n    .from(\'memoriais\')\n    .update({ user_id: targetUserId })\n    .eq(\'nome_homenageado\', \'Maximiliano Mamado\')\n    .select();\n\n  if (error) {\n    console.error(\"Error updating owner:\", error.message);\n    return;\n  }\n\n  console.log(`Successfully transferred ${updated.length} memorial to your account!`);\n  for (const m of updated) {\n    console.log(`- ID: ${m.id} | Nome: ${m.nome_homenageado} is now owned by ${m.user_id}`);\n  }\n\n  // 2. Also check if there are other memorials owned by the original creator that we should transfer\n  const { data: others, error: fetchOthersError } = await supabase\n    .from(\'memoriais\')\n    .select(\'id, nome_homenageado\')\n    .eq(\'user_id\', sourceUserId);\n\n  if (!fetchOthersError && others && others.length > 0) {\n    console.log(`\\nFound ${others.length} more memorials owned by contato@ecomemoriasapp.com. Transferring them too...`);\n    const { data: updatedOthers, error: updateOthersError } = await supabase\n      .from(\'memoriais\')\n      .update({ user_id: targetUserId })\n      .eq(\'user_id\', sourceUserId)\n      .select();\n\n    if (!updateOthersError && updatedOthers) {\n      console.log(`Transferred additional ${updatedOthers.length} memorials!`);\n      for (const m of updatedOthers) {\n        console.log(`- ID: ${m.id} | Nome: ${m.nome_homenageado}`);\n      }\n    }\n  }\n}\n\nrun();\n"
    }
